---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import Logo from '@/assets/logo.svg';

// Define types for your translations
interface NavTranslations {
  blog: string;
  contact: string;
}

interface Translations {
  nav: NavTranslations;
}

// Get current language from URL with type safety
const currentLocale = Astro.currentLocale as 'en' | 'th' || 'en';

// Import translations with types
import enTranslations from '@/i18n/en.json';
import thTranslations from '@/i18n/th.json';

// Create typed translations object
const translations: Record<'en' | 'th', Translations> = {
  en: enTranslations as Translations,
  th: thTranslations as Translations
};

// Get typed translations for current language
const t: Translations = translations[currentLocale];

// Language switching logic with types
const oppositeLocale: 'en' | 'th' = currentLocale === 'en' ? 'th' : 'en';
// Handle path extraction considering Thai is default (no prefix)
let currentPath: string;
if (currentLocale === 'en') {
  // Remove /en prefix from English URLs
  currentPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
} else {
  // For Thai (default locale), use the full path
  currentPath = Astro.url.pathname;
}
const languageSwitchUrl: string = getRelativeLocaleUrl(oppositeLocale, currentPath);

// Language display text
const languageButtonText: string = currentLocale === 'en' ? 'TH' : 'EN';
---

<div>
    <nav class="flex px-[80px] py-[20px] items-center justify-between">
        <a href={getRelativeLocaleUrl(currentLocale, '/')}>
            <Image src={Logo} alt="Logo" class="logo" width="80" height="80" loading={'eager'} />
        </a>
        <div class="flex items-center gap-14">
            <ul class="flex gap-10 items-center">
                <li>
                    <a href={getRelativeLocaleUrl(currentLocale, '/blog')}>
                        {t.nav.blog}
                    </a>
                </li>
                <li>
                    <a href={getRelativeLocaleUrl(currentLocale, '/contact')}>
                        {t.nav.contact}
                    </a>
                </li>
            </ul>
            <a 
                href={languageSwitchUrl} 
                class="p-3 rounded-2 hover:bg-black/10 rounded-lg"
                aria-label={`Switch to ${oppositeLocale === 'en' ? 'English' : 'Thai'}`}
            >
                {languageButtonText}
            </a>
        </div>
    </nav>
</div>