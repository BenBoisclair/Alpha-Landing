---
import { Image } from 'astro:assets';
import logoSquare from '@/assets/logo-square.svg';
import lineIcon from '@/assets/line-icon.svg';
import mailIcon from '@/assets/mail-icon.svg';
import { getRelativeLocaleUrl } from 'astro:i18n';

// Get current language
const currentLocale = Astro.currentLocale as 'en' | 'th' || 'th';

// Import translations
import enTranslations from '../i18n/en.json';
import thTranslations from '../i18n/th.json';

const translations = {
  en: enTranslations,
  th: thTranslations
};

const t = translations[currentLocale];
---

<footer class="bg-[#232323] text-white pt-12 sm:pt-16 md:pt-20 lg:pt-26 px-6 sm:px-10 md:px-16 lg:px-20 xl:px-36">
  <div class="flex flex-col md:flex-row md:justify-between gap-10 md:gap-8">
    <div class="flex flex-col gap-6 md:col-span-2 md:max-w-md lg:max-w-lg">
        <div class="flex items-center gap-4">
          <Image src={logoSquare} alt="Alpha AI Consulting Logo" width={45} height={45} />
          <span class="font-semibold text-white">{t.footer.companyName}</span>
        </div>
        <p class="text-sm sm:text-base font-extralight leading-relaxed">
          {t.footer.description}
        </p>
        <div class="flex flex-col gap-4 font-extralight">
          <div class="flex items-center gap-3 text-sm sm:text-base">
            <Image src={lineIcon} alt="Line Icon" width={20} height={20} class="flex-shrink-0 text-white" />
            <span>@alphaconsulting</span>
          </div>
          <div class="flex items-center gap-3 text-gray-300 text-sm sm:text-base">
            <Image src={mailIcon} alt="Mail Icon" width={20} height={20} class="flex-shrink-0 text-white" />
            <span class="break-all sm:break-normal">hello@alphabearconsulting.com</span>
          </div>
        </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 md:gap-12">
        <div>
            <h3 class="font-medium text-white mb-4 md:mb-6">{t.footer.services}</h3>
            <ul class="space-y-3 md:space-y-4">
                <li class="font-extralight text-sm sm:text-base hover:text-white cursor-pointer">{t.footer.servicesItems.chatbots}</li>
                <li class="font-extralight text-sm sm:text-base hover:text-white cursor-pointer">{t.footer.servicesItems.automation}</li>
                <li class="font-extralight text-sm sm:text-base hover:text-white cursor-pointer">{t.footer.servicesItems.dataProcessing}</li>
                <li class="font-extralight text-sm sm:text-base hover:text-white cursor-pointer">{t.footer.servicesItems.analytics}</li>
            </ul>
        </div>
        <div>
            <h3 class="font-medium text-white mb-4 md:mb-6">{t.footer.company}</h3>
            <ul class="space-y-3 md:space-y-4">
                <li class="font-extralight text-sm sm:text-base hover:text-white cursor-pointer">
                    <a href={getRelativeLocaleUrl(currentLocale, '/contact')}>{t.footer.companyItems.contact}</a>
                </li>
                <li class="font-extralight text-sm sm:text-base hover:text-white cursor-pointer">
                    <a href={getRelativeLocaleUrl(currentLocale, '/blog')}>{t.footer.companyItems.blog}</a>
                </li>
            </ul>
        </div>
    </div>
  </div>
  <div class="w-full flex justify-center py-6 sm:py-8 md:py-10 mt-8 md:mt-10 font-extralight text-xs sm:text-sm md:text-base text-center">© 2025 Alpha Bear Consulting. All rights reserved.</div>
</footer>