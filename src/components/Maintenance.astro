<div class="flex items-center justify-center min-h-[80vh]">
  <div class="text-center rounded-3xl p-8 md:p-12">
    <svg class="w-20 h-20 mx-auto mb-8 animate-spin-slow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <defs>
        <linearGradient id="cogGradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#cda7ff" />
          <stop offset="20%" stop-color="#cda7ff" />
          <stop offset="50%" stop-color="#8b32ff" />
        </linearGradient>
      </defs>
      <path stroke="url(#cogGradient)" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
      <path stroke="url(#cogGradient)" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
    <h1 class="text-3xl md:text-4xl font-bold text-black mb-4">Blog Under Maintenance</h1>
    <p class="text-lg font-extralight text-black mb-2">We're still constructing the blog!</p>
    <p class="text-lg font-extralight text-black mb-8">It will be online shortly. Thank you for your patience.</p>
  </div>
</div>

<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 4s linear infinite;
  }

  .animate-progress {
    animation: progress 3s ease-in-out infinite;
  }
</style>