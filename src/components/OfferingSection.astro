---
import Section from '@/layouts/Section.astro';
import robotIcon from '@/assets/OfferingSection/robot.svg';
import automationIcon from '@/assets/OfferingSection/automation.svg';
import chatIcon from '@/assets/OfferingSection/chat.svg';
import dataIcon from '@/assets/OfferingSection/data.svg';
import secureIcon from '@/assets/OfferingSection/secure.svg';
import analyticsIcon from '@/assets/OfferingSection/analytics.svg';
import { Image } from 'astro:assets';

// Get current language
const currentLocale = Astro.currentLocale as 'en' | 'th' || 'th';

// Import translations
import enTranslations from '../i18n/en.json';
import thTranslations from '../i18n/th.json';

const translations = {
  en: enTranslations,
  th: thTranslations
};

const t = translations[currentLocale];

// Service configuration with icons
const services = [
  { icon: robotIcon, key: 'chatbot' as keyof typeof t.offering.services },
  { icon: automationIcon, key: 'automation' as keyof typeof t.offering.services },
  { icon: dataIcon, key: 'dataProcessing' as keyof typeof t.offering.services },
  { icon: chatIcon, key: 'communication' as keyof typeof t.offering.services },
  { icon: analyticsIcon, key: 'analytics' as keyof typeof t.offering.services },
  { icon: secureIcon, key: 'security' as keyof typeof t.offering.services }
];
---

<Section>
    <div class="flex justify-center items-center w-full flex-col text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold text-center px-4">
        <h2>{t.offering.title} <span class="gradient-text">{t.offering.titleHighlight}</span></h2>
        <h2>{t.offering.subtitle}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6 mt-8 sm:mt-10 max-w-6xl mx-auto">
        {services.map((service) => (
            <div class="rounded-2xl border border-[#747474] flex-col p-6 sm:p-8 lg:p-10 gap-3 flex items-start w-full min-h-[250px] lg:min-h-[297px]">
                <Image src={service.icon} alt={`${service.key} Icon`} class="w-10 h-10 sm:w-12 sm:h-12 lg:w-[50px] lg:h-[50px]" width="50" height="50" />
                <h3 class="font-bold text-lg sm:text-[20px]">{t.offering.services[service.key].title}</h3>
                <p class="text-sm sm:text-base">{t.offering.services[service.key].description}</p>
            </div>
        ))}
    </div>
</Section>