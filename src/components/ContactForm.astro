---
import type { ContactFormTranslations } from '@/types/translations';
import Button from './Button.astro';

interface Props {
  formText: ContactFormTranslations;
}

const { formText } = Astro.props;
---

<div class="bg-white p-8 rounded-lg">
  <form id="contact-form" class="space-y-6">
    <!-- Status Messages -->
    <div id="success-message" class="hidden p-4 bg-green-50 border border-green-200 text-green-700 rounded-lg">
      ✓ {formText.success}
    </div>

    <div id="error-message" class="hidden p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg">
      <span id="error-text">{formText.error}</span>
    </div>

    <!-- Name Field -->
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
        {formText.name} <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none"
      />
      <span class="error-msg hidden text-red-500 text-sm mt-1"></span>
    </div>

    <!-- Email Field -->
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
        {formText.email} <span class="text-red-500">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none"
      />
      <span class="error-msg hidden text-red-500 text-sm mt-1"></span>
    </div>

    <!-- Message Field -->
    <div>
      <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
        {formText.message} <span class="text-red-500">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="6"
        required
        class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none resize-y"
      ></textarea>
      <span class="error-msg hidden text-red-500 text-sm mt-1"></span>
    </div>

    <!-- Submit Button -->
    <Button
      type="submit"
      id="submit-btn"
      variant="primary"
      class="w-full"
    >
      <span id="btn-text">{formText.send}</span>
    </Button>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const successMsg = document.getElementById('success-message');
  const errorMsg = document.getElementById('error-message');
  const errorText = document.getElementById('error-text');

  // Validation helpers stay the same
  function validateEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function showError(input: HTMLInputElement, message: string) {
    const errorSpan = input.parentElement?.querySelector('.error-msg');
    if (errorSpan) {
      errorSpan.textContent = message;
      errorSpan.classList.remove('hidden');
      input.classList.add('border-red-500');
    }
  }

  function clearErrors() {
    const errorSpans = form.querySelectorAll('.error-msg');
    errorSpans.forEach(span => {
      span.textContent = '';
      span.classList.add('hidden');
    });
    const inputs = form.querySelectorAll('input, textarea');
    inputs.forEach(input => {
      input.classList.remove('border-red-500');
    });
  }

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Clear previous errors
    clearErrors();
    if (successMsg) successMsg.classList.add('hidden');
    if (errorMsg) errorMsg.classList.add('hidden');
    
    // Get the FormData
    const formData = new FormData(form);
    
    // Extract values for validation
    const name = formData.get('name')?.toString().trim() || '';
    const email = formData.get('email')?.toString().trim() || '';
    const message = formData.get('message')?.toString().trim() || '';
    
    // Validate
    let hasErrors = false;
    
    if (!name) {
      showError(form.querySelector('#name') as HTMLInputElement, 'Name is required');
      hasErrors = true;
    }
    
    if (!email) {
      showError(form.querySelector('#email') as HTMLInputElement, 'Email is required');
      hasErrors = true;
    } else if (!validateEmail(email)) {
      showError(form.querySelector('#email') as HTMLInputElement, 'Please enter a valid email');
      hasErrors = true;
    }
    
    if (!message) {
      showError(form.querySelector('#message') as HTMLInputElement, 'Message is required');
      hasErrors = true;
    }
    
    if (hasErrors) return;
    
    // Update button
    if (submitBtn && btnText) {
      submitBtn.disabled = true;
      btnText.textContent = 'Sending...';
    }
    
    try {
      // Send JSON data to API endpoint
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          name,
          email,
          message,
        }),
      });
      
      const result = await response.json();
      
      if (!response.ok) {
        throw new Error(result.error || 'Failed to send message');
      }
      
      // Success!
      if (successMsg) {
        successMsg.classList.remove('hidden');
        form.reset();
        successMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      
    } catch (error) {
      // Show error
      if (errorMsg && errorText) {
        errorText.textContent = error instanceof Error 
          ? error.message 
          : 'Something went wrong. Please try again.';
        errorMsg.classList.remove('hidden');
      }
    } finally {
      // Reset button
      if (submitBtn && btnText) {
        submitBtn.disabled = false;
        btnText.textContent = 'Send Message';
      }
    }
  });
</script>