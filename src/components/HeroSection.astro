---
import Button from "./Button.astro";
import { getRelativeLocaleUrl } from 'astro:i18n';

// Get current language
const currentLocale = Astro.currentLocale as 'en' | 'th' || 'th';

// Import translations
import enTranslations from '../i18n/en.json';
import thTranslations from '../i18n/th.json';

const translations = {
  en: enTranslations,
  th: thTranslations
};

const t = translations[currentLocale];

// Format typed strings for the script
const typedStrings = t.hero.typedStrings.map((str: string, index: number) => {
  const classes = ['gradient-text', 'gradient-text-2', 'gradient-text-3'];
  return `<span class="${classes[index % classes.length]}">${str}</span>`;
});
---

<div class="relative flex justify-center items-center flex-col gap-4 sm:gap-6 min-h-[90vh] pb-16 sm:pb-24 md:pb-32 lg:pb-40 px-4 sm:px-6">
    <!-- Particles Background -->
    <div id="tsparticles" class="absolute inset-0 -z-10"></div>

    <!-- Content wrapper -->
    <div class="relative z-10 flex flex-col items-center gap-4 sm:gap-6">
        <div class="flex flex-col gap-2 text-center font-bold text-3xl sm:text-4xl md:text-5xl lg:text-[58px]">
          <h1>{t.hero.title}</h1>
          <div class="h-[1.2em] flex items-center justify-center">
            <h2 id="typed-text"></h2>
          </div>
        </div>
        <span class="font-medium text-sm sm:text-base md:text-lg text-center px-4">{t.hero.subtitle}
            <span class="text-[#3F33CB] ">{t.hero.subtitleHighlight}</span>
            {t.hero.subtitleEnd && ` ${t.hero.subtitleEnd}`}
        </span>

        <a href={getRelativeLocaleUrl(currentLocale, '/contact')}>
            <Button variant="primary">{t.hero.cta}</Button>
        </a>
    </div>
</div>

<!-- Store the strings in a data attribute -->
<div id="typed-strings" data-strings={JSON.stringify(typedStrings)} style="display: none;"></div>

<script>
  // Wait for the DOM to be ready
  document.addEventListener('DOMContentLoaded', () => {
    // Import Typed.js
    import('typed.js').then(({ default: Typed }) => {
      // Get the strings from the data attribute
      const stringsElement = document.getElementById('typed-strings');
      const typedElement = document.getElementById('typed-text');
      
      if (stringsElement && typedElement) {
        const strings = JSON.parse(stringsElement.dataset.strings || '[]');
        
        // Initialize Typed.js
        new Typed('#typed-text', {
          strings: strings,
          typeSpeed: 50,
          backSpeed: 30,
          loop: true,
          showCursor: false,
          contentType: 'html'
        });
      }
    }).catch(error => {
      console.error('Failed to load Typed.js:', error);
    });
  });
</script>