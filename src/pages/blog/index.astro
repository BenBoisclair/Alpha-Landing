---
import Layout from "@/layouts/Layout.astro";
import Section from "@/layouts/Section.astro";
import Button from "@/components/Button.astro";
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';

// Get current language
const currentLocale = Astro.currentLocale as 'en' | 'th' || 'th';

// Import translations
import enTranslations from '../../i18n/en.json';
import thTranslations from '../../i18n/th.json';

const translations = {
  en: enTranslations,
  th: thTranslations
};

const t = translations[currentLocale];

// Get all blog posts sorted by date
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Format date based on locale
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(currentLocale === 'th' ? 'th-TH' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
};

// Function to truncate description
const truncateText = (text: string, maxLength: number = 150) => {
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength).trim() + '...';
};

// Get featured posts (latest 3)
const featuredPosts = sortedPosts.slice(0, 3);
const remainingPosts = sortedPosts.slice(3);
---

<Layout>
  <!-- Hero Section -->
  <section class="relative min-h-[50vh] flex items-center justify-center py-20 px-4 sm:px-6 overflow-hidden bg-[#232323]">
    <!-- Background gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-br from-purple-100/20 via-transparent to-purple-100/10 -z-10"></div>

    <!-- Animated background particles -->
    <div class="absolute inset-0 -z-20">
      <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-purple-300/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-blue-300/10 rounded-full blur-3xl animate-pulse delay-1000"></div>
    </div>

    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-white">
        {t.blog?.title || 'AI Insights & Innovation'}
      </h1>
      <p class="text-lg sm:text-xl text-gray-300 mb-8">
        {t.blog?.subtitle || 'Explore the latest in AI automation, business transformation, and technology trends'}
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <Button variant="primary">
          {t.blog?.latestPosts || 'Latest Posts'}
        </Button>
        <a href={getRelativeLocaleUrl(currentLocale, '/contact')}>
          <Button variant="secondary">
            {t.blog?.subscribe || 'Get Updates'}
          </Button>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Posts Section -->
  {featuredPosts.length > 0 && (
    <Section>
      <div class="mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
          {t.blog?.featured || 'Featured Articles'}
        </h2>
        <p class="text-center text-gray-600 max-w-2xl mx-auto">
          {t.blog?.featuredSubtitle || 'Deep dives into AI implementation and digital transformation strategies'}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
        {featuredPosts.map((post, index) => (
          <article class={`group ${index === 0 ? 'lg:col-span-2 lg:row-span-2' : ''}`}>
            <a href={`/blog/${post.id}`} class="block h-full">
              <div class="relative overflow-hidden rounded-2xl border border-gray-200 hover:border-purple-300 transition-all duration-300 h-full flex flex-col hover:shadow-xl hover:-translate-y-1">
                {post.data.heroImage && (
                  <div class={`relative overflow-hidden ${index === 0 ? 'h-96' : 'h-48'}`}>
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      width={800}
                      height={400}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  </div>
                )}

                <div class="p-6 sm:p-8 flex-grow flex flex-col">
                  <div class="flex items-center gap-3 mb-3 text-sm text-gray-500">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate)}
                    </time>
                  </div>

                  <h3 class={`font-bold mb-3 group-hover:text-purple-600 transition-colors ${index === 0 ? 'text-2xl sm:text-3xl' : 'text-xl'}`}>
                    {post.data.title}
                  </h3>

                  <p class={`text-gray-600 mb-4 flex-grow ${index === 0 ? 'text-base sm:text-lg' : 'text-sm sm:text-base'}`}>
                    {truncateText(post.data.description, index === 0 ? 200 : 120)}
                  </p>

                  <div class="flex items-center text-purple-600 font-medium group-hover:gap-3 transition-all">
                    <span>{t.blog?.readMore || 'Read More'}</span>
                    <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </Section>
  )}

  <!-- All Posts Grid -->
  {remainingPosts.length > 0 && (
    <Section class="bg-gray-50">
      <div class="mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
          {t.blog?.allPosts || 'All Articles'}
        </h2>
        <p class="text-center text-gray-600 max-w-2xl mx-auto">
          {t.blog?.allPostsSubtitle || 'Insights, tutorials, and updates from the world of AI and automation'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {remainingPosts.map((post) => (
          <article class="group">
            <a href={`/blog/${post.id}`} class="block">
              <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:border-purple-300 hover:shadow-lg transition-all duration-300 h-full flex flex-col">
                {post.data.heroImage && (
                  <div class="relative h-48 overflow-hidden">
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      width={400}
                      height={200}
                    />
                  </div>
                )}

                <div class="p-6 flex-grow flex flex-col">
                  <time class="text-sm text-gray-500 mb-2" datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>

                  <h3 class="text-xl font-bold mb-2 group-hover:text-purple-600 transition-colors">
                    {post.data.title}
                  </h3>

                  <p class="text-gray-600 text-sm mb-4 flex-grow">
                    {truncateText(post.data.description, 100)}
                  </p>

                  <div class="flex items-center text-purple-600 text-sm font-medium group-hover:gap-3 transition-all">
                    <span>{t.blog?.readArticle || 'Read Article'}</span>
                    <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </Section>
  )}

  <!-- Newsletter CTA -->
  <Section class="gradient-bg-alt text-white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        {t.blog?.newsletterTitle || 'Stay Ahead of the Curve'}
      </h2>
      <p class="text-lg mb-8 opacity-90">
        {t.blog?.newsletterSubtitle || 'Get the latest AI insights and automation strategies delivered to your inbox'}
      </p>
      <a href={getRelativeLocaleUrl(currentLocale, '/contact')}>
        <Button variant="secondary">
          {t.blog?.subscribeButton || 'Subscribe to Newsletter'}
        </Button>
      </a>
    </div>
  </Section>
</Layout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .delay-1000 {
    animation-delay: 1000ms;
  }
</style>